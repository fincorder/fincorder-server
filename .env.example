AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
CORS_ORIGINS="http://localhost:5173"



# Use one connection string for both the app and migrations (Neon or local PostgreSQL).
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3="https://<your-neon-storage-endpoint>"
AWS_ACCESS_KEY_ID="<generate-key>"
AWS_SECRET_ACCESS_KEY="<generate-key>"
AWS_REGION="ap-southeast-1"
S3_BUCKET="pfp"
S3_AVATAR_URL_EXPIRY_SECONDS=604800
